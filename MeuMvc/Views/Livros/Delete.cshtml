@model Livro

<h1>Excluir livro</h1>
<p class="text-danger">Tem certeza que deseja excluir este livro?</p>

<dl class="row">
    <dt class="col-sm-2">Título</dt>
    <dd class="col-sm-10">@Model.Titulo</dd>

    <dt class="col-sm-2">Autor</dt>
    <dd class="col-sm-10">@Model.Autor</dd>

    <dt class="col-sm-2">Ano</dt>
    <dd class="col-sm-10">@Model.Ano</dd>
</dl>

<form asp-action="Delete" method="post">
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>